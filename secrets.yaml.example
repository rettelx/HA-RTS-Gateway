# Template for the secrets.yaml file of the Somfy RTS gateway.
#
# Copy this file to `secrets.yaml` (next to `esphome.yaml`) and fill in
# your own values. `secrets.yaml` is git-ignored: your credentials will
# never be published.

# WiFi network of the gateway
wifi_ssid: "MySSID"
wifi_password: "WiFiPassword"

# Home Assistant <-> gateway API key (ESPHome).
# Generate a random key (base64, as required by ESPHome), for
# example with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_key: "paste-a-random-64-hex-character-key-here"
